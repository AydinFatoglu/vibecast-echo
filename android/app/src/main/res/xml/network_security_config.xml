<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays off everywhere except loopback, where the receiver's own
  player bridge is served. The WebView player loads that page over plain HTTP
  from inside this process; nothing leaves the device on that connection.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
